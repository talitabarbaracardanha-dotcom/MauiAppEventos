<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.ResumoEventos"
             Title="ResumoEventos"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray900}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             VerticalOptions="CenterAndExpand">

            <VerticalStackLayout Spacing="5" Margin="0,10,0,10">
                <Label Text="Tally Eventos"
                       FontFamily="Outfit"
                       FontSize="30"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource White}"/>

                <Label Text="Seu evento, Sua história"
                       FontSize="16"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}"
                       CharacterSpacing="1"/>
            </VerticalStackLayout>

            <Label Text="Resumo do Evento"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Frame Margin="10"
                   Padding="20"
                   CornerRadius="20">

                <Frame.Shadow>
                    <Shadow Brush="Gray"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.15"/>
                </Frame.Shadow>

                <VerticalStackLayout Spacing="10">
                    
                    <HorizontalStackLayout>
                        <Label Text="Nome do Evento:"
                               FontAttributes="Bold"
                               WidthRequest="120"/>
                        <Label Text="{Binding nomeevento}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Local do Evento:"
                               FontAttributes="Bold"
                               WidthRequest="120"/>
                        <Label Text="{Binding localevento}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Tipo de Evento: "
                               FontAttributes="Bold" 
                               WidthRequest="110" />
                        <Label Text="{Binding EventoSelecionado.Descricao}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Participantes Adultos: "
                               FontAttributes="Bold"
                               WidthRequest="152"/>
                        <Label Text="{Binding QntAdultos}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Participantes Crianças: "
                               FontAttributes="Bold"
                               WidthRequest="160"/>
                        <Label Text="{Binding QntCriancas}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Total Participantes: "
                               FontAttributes="Bold"
                               WidthRequest="160"/>
                        <Label Text="{Binding TotalParticipantes}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Data de Início: "
                               FontAttributes="Bold"
                               WidthRequest="100"/>
                        <Label Text="{Binding datainicio, StringFormat='{0:dd/MM/yyyy}'}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Data de Término: "
                               FontAttributes="Bold"
                               WidthRequest="120"/>
                        <Label Text="{Binding datatermino, StringFormat='{0:dd/MM/yyyy}'}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label Text="Duração do Evento: "
                               FontAttributes="Bold"
                               WidthRequest="140"/>
                        <Label Text="{Binding TotalDiasEvento}" />
                        <Label Text=" dia(s)" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="LightGray"
                             Margin="0,10"/>

                    <HorizontalStackLayout>
                        <Label Text="Valor Total: "
                               FontAttributes="Bold"
                               WidthRequest="140"
                               FontSize="20" />

                        <Label Text="{Binding ValorTotal, StringFormat='{}{0:C}'}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>

            <Button Text="Voltar"
                    WidthRequest="150"
                    CornerRadius="20"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>